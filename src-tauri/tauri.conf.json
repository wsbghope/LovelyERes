{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LovelyRes",
  "version": "0.7.0",
  "identifier": "com.lovelyres.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LovelyERes - Linux Emergency Response Tool",
        "width": 1600,
        "height": 900,
        "decorations": true,
        "center": true,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "fullscreen": false,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["default", "ssh-terminal", "web-terminal"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/capture/NOTICE.md": "resources/capture/NOTICE.md",
      "resources/capture/licenses/": "resources/capture/licenses/",
      "../LovelyERes-Resources/": "LovelyERes-Resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
